programa {
  funcao inicio() {
   inteiro opcao
   real numero1, numero2, resultado

   faca{
    escreva("\n Calculadora \n")
    escreva("1 - Soma \n")
    escreva("2 - Subtracão \n")
    escreva("3 - Multiplicação \n")
     escreva("4 - Dividir \n")
     escreva("0 - Sair \n")
     escreva("Escolha uma opcão: ")
     leia(opcao)
      se  (opcao > 4) {
        escreva("Essa opçao não é valida")
      } 

      

   } enquanto (opcao != 0)

    
  }
}
