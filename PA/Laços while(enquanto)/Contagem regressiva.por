programa {
  funcao inicio() {
   inteiro contagemRegressiva

   escreva("\n Bem vindo a contagem regressiva!!") 

   contagemRegressiva = 10

   enquanto(contagemRegressiva >= 0) {
      escreva("\n",contagemRegressiva)

    contagemRegressiva = contagemRegressiva - 1
   }

   escreva("\nFIM!")
  }
}
